rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collection Rules ---

    // Users
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['settings', 'displayName'])
      );

      function isValidUser(data) {
        return data.uid == request.auth.uid &&
               data.email is string &&
               data.settings.theme in ['light', 'dark'] &&
               data.settings.focusMode is bool;
      }
    }

    // Tasks
    match /tasks/{taskId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidTask(incoming());
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidTask(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'name', 'reminderTime', 'isFocusTask'])
      );
      allow delete: if isSignedIn() && isOwner(existing().userId);

      function isValidTask(data) {
        return data.userId == request.auth.uid &&
               data.name is string && data.name.size() > 0 && data.name.size() < 500 &&
               data.date is string && data.date.size() == 10 &&
               data.completed is bool &&
               data.isFocusTask is bool;
      }
    }

    // Habits
    match /habits/{habitId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidHabit(incoming());
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidHabit(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['streak', 'lastCompletedDate', 'name', 'active', 'frequency', 'reminderTime'])
      );
      allow delete: if isSignedIn() && isOwner(existing().userId);

      function isValidHabit(data) {
        return data.userId == request.auth.uid &&
               data.name is string && data.name.size() > 0 && data.name.size() < 500 &&
               data.frequency in ['daily', 'weekly', 'custom'] &&
               data.streak is number && data.streak >= 0 &&
               data.active is bool;
      }
    }

    // Habit Completions
    match /habitCompletions/{completionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidCompletion(incoming());
      allow delete: if isSignedIn() && isOwner(existing().userId);

      function isValidCompletion(data) {
        return data.userId == request.auth.uid &&
               data.habitId is string &&
               data.date is string && data.date.size() == 10;
      }
    }
  }
}
