{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User preferences and profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "settings": {
          "type": "object",
          "properties": {
            "focusMode": { "type": "boolean" },
            "theme": { "type": "string", "enum": ["light", "dark"] },
            "notificationsEnabled": { "type": "boolean" }
          },
          "required": ["focusMode", "theme", "notificationsEnabled"]
        }
      },
      "required": ["uid", "email", "settings"]
    },
    "Task": {
      "title": "Task",
      "description": "A daily task tracked by the user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "completed": { "type": "boolean" },
        "date": { "type": "string", "description": "YYYY-MM-DD" },
        "reminderTime": { "type": "string" },
        "isFocusTask": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "name", "completed", "date", "isFocusTask", "createdAt"]
    },
    "Habit": {
      "title": "Habit",
      "description": "A recurring habit defined by the user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "frequency": { "type": "string", "enum": ["daily", "weekly", "custom"] },
        "reminderTime": { "type": "string" },
        "streak": { "type": "number" },
        "lastCompletedDate": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "name", "frequency", "streak", "active", "createdAt"]
    },
    "HabitCompletion": {
      "title": "Habit Completion",
      "description": "A specific instance of a habit completed on a date",
      "type": "object",
      "properties": {
        "habitId": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["habitId", "userId", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Global user profiles"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "User tasks"
    },
    "/habits/{habitId}": {
      "schema": "Habit",
      "description": "User habit definitions"
    },
    "/habitCompletions/{completionId}": {
      "schema": "HabitCompletion",
      "description": "Historical habit completion records"
    }
  }
}
