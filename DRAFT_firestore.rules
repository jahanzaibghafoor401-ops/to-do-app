rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isEmailVerified() {
      // For this app, we assume Google login satisfies this, but strictly:
      return request.auth.token.email_verified == true;
    }

    // --- Collection Rules ---

    // Users
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['settings', 'displayName']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['settings'])
      );

      function isValidUser(data) {
        return data.uid == request.auth.uid &&
               data.email is string && data.email.size() > 0 && data.email.size() < 256 &&
               data.settings.theme in ['light', 'dark'] &&
               data.settings.focusMode is bool &&
               data.settings.notificationsEnabled is bool &&
               data.keys().hasAll(['uid', 'email', 'settings']) &&
               (data.keys().size() == 3 || (data.keys().size() == 4 && data.displayName is string));
      }
    }

    // Tasks
    match /tasks/{taskId} {
      allow get: if isSignedIn() && isOwner(existing().userId) && isValidId(taskId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidId(taskId) && isValidTask(incoming());
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidId(taskId) && isValidTask(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'name', 'reminderTime', 'isFocusTask']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['completed'])
      );
      allow delete: if isSignedIn() && isOwner(existing().userId) && isValidId(taskId);

      function isValidTask(data) {
        return data.userId == request.auth.uid &&
               data.name is string && data.name.size() > 0 && data.name.size() < 500 &&
               data.date is string && data.date.size() == 10 &&
               data.completed is bool &&
               data.isFocusTask is bool &&
               data.createdAt is number &&
               data.keys().hasAll(['userId', 'name', 'completed', 'date', 'isFocusTask', 'createdAt']) &&
               (data.keys().size() == 6 || (data.keys().size() == 7 && data.reminderTime is string));
      }
    }

    // Habits
    match /habits/{habitId} {
      allow get: if isSignedIn() && isOwner(existing().userId) && isValidId(habitId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidId(habitId) && isValidHabit(incoming());
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidId(habitId) && isValidHabit(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['streak', 'lastCompletedDate', 'name', 'active', 'frequency', 'reminderTime']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['streak', 'lastCompletedDate'])
      );
      allow delete: if isSignedIn() && isOwner(existing().userId) && isValidId(habitId);

      function isValidHabit(data) {
        return data.userId == request.auth.uid &&
               data.name is string && data.name.size() > 0 && data.name.size() < 500 &&
               data.frequency in ['daily', 'weekly', 'custom'] &&
               data.streak is number && data.streak >= 0 &&
               data.active is bool &&
               data.createdAt is number &&
               data.keys().hasAll(['userId', 'name', 'frequency', 'streak', 'active', 'createdAt']) &&
               (data.keys().size() == 6 || (data.keys().size() >= 7 && data.keys().size() <= 8));
      }
    }

    // Habit Completions
    match /habitCompletions/{completionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidId(completionId) && isValidCompletion(incoming());
      allow delete: if isSignedIn() && isOwner(existing().userId) && isValidId(completionId);

      function isValidCompletion(data) {
        return data.userId == request.auth.uid &&
               data.habitId is string && isValidId(data.habitId) &&
               data.date is string && data.date.size() == 10 &&
               data.keys().hasAll(['userId', 'habitId', 'date']) &&
               data.keys().size() == 3;
      }
    }
  }
}
